          },
          {
            "properties": {
              "categories": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "cookMinutes": {
                "type": "integer"
              },
              "description": {
                "type": "string"
              },
              "householdId": {
                "type": "string"
              },
              "ingredients": {
                "items": {
                  "$ref": "#/components/schemas/Ingredient"
                },
                "type": "array"
              },
              "photoKeys": {
                "$ref": "#/components/schemas/PhotoKeys"
              },
              "prepMinutes": {
                "type": "integer"
              },
              "rating": {
                "maximum": 5,
                "minimum": 0,
