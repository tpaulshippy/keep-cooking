              },
              "totalMinutes": {
                "type": "integer"
              }
            },
            "required": [
              "title",
              "servings"
            ],
            "type": "object"
          }
        ]
      },
      "RecipeInput": {
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cookMinutes": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "householdId": {
            "type": "string"
          },
          "ingredients": {
            "items": {
