  "info": {
    "description": "Single Hono Worker + D1 + R2. MIT only. See packages/contracts/README.md.",
    "title": "Smidgen API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/clip": {
