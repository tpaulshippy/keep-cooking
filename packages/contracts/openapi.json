            },
            "type": "array"
          },
          "photoKeys": {
            "$ref": "#/components/schemas/PhotoKeys"
          },
          "prepMinutes": {
            "type": "integer"
          },
          "rating": {
            "maximum": 5,
            "minimum": 0,
            "type": "number"
          },
          "servings": {
            "default": 4,
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepInput"
            },
