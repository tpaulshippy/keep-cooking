{
  "components": {
    "parameters": {
      "HouseholdId": {
        "in": "query",
        "name": "householdId",
        "schema": {
          "type": "string"
        }
      },
      "IdParam": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ClipReport": {
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "recipe": {
            "$ref": "#/components/schemas/RecipeInput"
          },
          "sourceUrl": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "jsonld",
              "reader",
              "caption",
              "ocr"
            ],
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "strategy",
          "recipe"
        ],
        "type": "object"
      },
      "ClipRequest": {
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "caption"
            ]
          }
        ],
        "properties": {
          "caption": {
            "type": "string"
          },
          "source": {
            "enum": [
              "url",
              "tiktok",
              "instagram",
              "youtube",
              "ocr",
              "clipboard"
            ],
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EncryptedEnvelope": {
        "description": "E2E v2 wrapper around a SyncEnvelope. Server stores bytes only; see docs/e2e-v1.md. v1 SyncEnvelope is unchanged.",
        "properties": {
          "alg": {
            "const": "AES-GCM-256",
            "description": "cipher (locked)",
            "type": "string"
          },
          "ciphertext": {
            "AES-GCM-256(raw-ciphertext + 16-byte tag) over canonical JSON of the v1 envelope payload": null,
            "description": "base64",
            "type": "string"
          },
          "deleted": {
            "default": false,
            "type": "boolean"
          },
          "deviceId": {
            "type": "string"
          },
          "entity": {
            "description": "standalone ingredient/step envelopes are rejected (fold into the parent recipe pre-encrypt)",
            "enum": [
              "recipe",
              "list",
              "pantryItem",
              "plan",
              "menu"
            ],
            "type": "string"
          },
          "householdHash": {
            "description": "hex(SHA256(\"smidgen-hh-v1\" || syncCode || householdId)); must equal the :hash path param",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kid": {
            "description": "opaque per-household key id; feeds the HKDF info string",
            "type": "string"
          },
          "nonce": {
            "12 random bytes": null,
            "description": "base64",
            "fresh per envelope (AES-GCM)": null,
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "v": {
            "const": 2,
            "description": "envelope version",
            "type": "integer"
          }
        },
        "required": [
          "v",
          "alg",
          "kid",
          "householdHash",
          "id",
          "entity",
          "updatedAt",
          "deviceId",
          "nonce",
          "ciphertext"
        ],
        "type": "object"
      },
      "Household": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "member",
              "viewer"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Ingredient": {
        "properties": {
          "display": {
            "description": "fraction-rounded string e.g. 1 1/2 cups",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "quantity": {
            "nullable": true,
            "type": "number"
          },
          "recipeId": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "IngredientInput": {
        "properties": {
          "display": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "quantity": {
            "nullable": true,
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ListItem": {
        "properties": {
          "aisle": {
            "type": "string"
          },
          "checked": {
            "default": false,
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "recipeId": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "ListItemInput": {
        "properties": {
          "aisle": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "recipeId": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "Menu": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SyncEnvelope"
          },
          {
            "properties": {
              "entries": {
                "items": {
                  "properties": {
                    "dayOffset": {
                      "type": "integer"
                    },
                    "meal": {
                      "type": "string"
                    },
                    "recipeId": {
                      "type": "string"
                    },
                    "servings": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "householdId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "type": "object"
          }
        ]
      },
      "MenuInput": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "dayOffset": {
                  "type": "integer"
                },
                "meal": {
                  "type": "string"
                },
                "recipeId": {
                  "type": "string"
                },
                "servings": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "householdId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "PantryItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SyncEnvelope"
          },
          {
            "properties": {
              "barcode": {
                "type": "string"
              },
              "expiresAt": {
                "format": "date",
                "nullable": true,
                "type": "string"
              },
              "householdId": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "lowThreshold": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "quantity": {
                "type": "string"
              }
            },
            "type": "object"
          }
        ]
      },
      "PantryItemInput": {
        "properties": {
          "barcode": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date",
            "nullable": true,
            "type": "string"
          },
          "householdId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "lowThreshold": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "PhotoKeys": {
        "description": "R2 keys. URL signing <15min. Variants thumb/1024/original.",
        "properties": {
          "large1024": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "thumb": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Plan": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SyncEnvelope"
