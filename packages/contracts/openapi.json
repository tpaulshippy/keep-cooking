    "/v2/sync/{hash}": {
      "delete": {
        "operationId": "e2eWipe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "wiped": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "wiped"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "wiped row count"
          }
        }
      },
      "get": {
        "operationId": "e2ePull",
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EncryptedEnvelope"
                  },
                  "type": "array"
                }
              }
            },
            "description": "encrypted envelopes changed since timestamp"
          }
        }
      },
      "parameters": [
        {
          "description": "hex householdHash (see docs/e2e-v1.md)",
          "in": "path",
          "name": "hash",
          "required": true,
          "schema": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      ],
      "put": {
        "operationId": "e2ePush",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/EncryptedEnvelope"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "stored": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "stored"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "stored ids (stale writes are idempotent no-ops)"
          }
        }
      }
    }
