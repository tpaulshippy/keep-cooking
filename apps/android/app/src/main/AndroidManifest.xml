<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".KeepCookingApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeepCooking">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KeepCooking">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Clip intake: receive shared URLs/text (parity with ShareExtension). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- App shortcuts (parity with KeepCookingIntents). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="com.keepcooking.app.ADD_RECIPE" />
                <action android:name="com.keepcooking.app.START_TIMER" />
                <action android:name="com.keepcooking.app.ADD_TO_LIST" />
                <action android:name="com.keepcooking.app.NEXT_STEP" />
                <action android:name="com.keepcooking.app.PREV_STEP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Cook timer alerts: AlarmManager wakes this receiver, which posts the notification. -->
        <receiver
            android:name=".cook.CookTimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.keepcooking.app.cook.TIMER_FIRED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (parity with KeepCookingWidgets). -->
        <receiver
            android:name=".widgets.TodayPlanWidget"
            android:exported="false"
            android:label="@string/widget_today_plan_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_plan" />
        </receiver>
        <receiver
            android:name=".widgets.ListProgressWidget"
            android:exported="false"
            android:label="@string/widget_list_progress_desc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_list_progress" />
        </receiver>
    </application>
</manifest>
