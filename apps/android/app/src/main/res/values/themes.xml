<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral platform parent (no forced light/dark): enableEdgeToEdge()
         in MainActivity manages status/nav bar contrast for both themes;
         Compose draws everything else. -->
    <style name="Theme.KeepCooking" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
